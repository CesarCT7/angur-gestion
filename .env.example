# El arrancador reemplaza estas dos claves con valores aleatorios al crear .env.
MYSQL_ROOT_PASSWORD=reemplaza-esta-clave-local
DB_PASSWORD=reemplaza-esta-otra-clave-local
DB_USER=angur
DB_URL=jdbc:mysql://localhost:3306/angur_gestion?serverTimezone=America/Mexico_City
SERVER_PORT=18080
AUTH_MAIL_ENABLED=true
AUTH_MAIL_FROM=no-reply@angur.local
AUTH_BASE_URL=http://localhost:18080
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL=false
ANGUR_USE_DOCKER=true
SESSION_COOKIE_SECURE=false
